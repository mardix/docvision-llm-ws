# docvision-llm-ws configuration. Copy to .env (scripts/setup-env.sh does this and generates a token).
# Only DOCVISION_TOKEN is required; everything else has a sensible default.
# Real environment variables override this file.
# Sizes: B, KB, KiB, MB, MiB, GB, GiB.  Durations: ms, s, m, h, d.

# --- Server ----------------------------------------------------------------

# Access token every request must send in the X-ACCESS-TOKEN header (also used to sign in to
# the dashboard). Required, at least 16 characters; keep it secret.
DOCVISION_TOKEN=

# Address and port to listen on. 0.0.0.0 accepts connections from other machines;
# use 127.0.0.1 to allow only local clients.
DOCVISION_BIND=0.0.0.0:4242

# Folder for the database, downloaded sources and result files. The only place the service
# writes to, so point it at persistent storage (a volume in Docker).
DOCVISION_DATA_DIR=./data

# Database for jobs and request history. Default: SQLite at DATA_DIR/docvision.sqlite.
# Set postgres://user:password@host:5432/dbname to share one database or use managed PostgreSQL.
# DOCVISION_DATABASE_URL=

# Key that encrypts stored secrets (S3 credentials, API keys, webhook headers) of queued jobs.
# 32 bytes, base64. Default: derived from DOCVISION_TOKEN; set it if you may change the token,
# otherwise jobs queued before the change can't be decrypted.
# DOCVISION_ENCRYPTION_KEY=

# How much the service logs: error, warn, info, debug, or a filter such as
# info,docvision_llm_ws::gateway=debug to trace one area.
DOCVISION_LOG_LEVEL=info

# Log format: json for log collectors (one object per line), text for reading in a terminal.
DOCVISION_LOG_FORMAT=json

# --- Capacity ----------------------------------------------------------------

# Memory conversions may reserve, as a size (512MiB) or a percentage (50%).
# Protects against running out of memory: work waits for room instead of crashing.
# Default: 60% of the container's memory limit (or of the machine's memory).
# DOCVISION_MEMORY_BUDGET=

# Async jobs that may run at once. They mostly wait on the LLM, so a high number is fine;
# lower it to limit load on your LLM account or the machine.
DOCVISION_MAX_CONCURRENT_JOBS=512

# Async jobs that may wait to start. When full, new requests get 429 with Retry-After,
# so clients back off instead of piling up.
DOCVISION_QUEUE_DEPTH=1024

# Largest source document accepted. Rejects oversized files before they use disk or LLM tokens.
DOCVISION_MAX_INPUT_BYTES=200MiB

# Longest an async job may run. Stops stuck jobs; optional steps (title, summary, translation,
# extraction) stop a little earlier so what's done is kept.
DOCVISION_JOB_TIMEOUT=15m

# --- Retention ---------------------------------------------------------------

# How long results, finished jobs and cached conversions are kept. Longer means more cache hits
# (repeat conversions are free) but more disk use.
DOCVISION_RESULT_RETENTION=24h

# How long request history is kept (dashboard, history.list, stats). Contains no document content.
DOCVISION_HISTORY_RETENTION=30d

# --- Default LLM -------------------------------------------------------------
# Used for PDFs, images, LLM titles/summaries and structured extraction. Any request can override
# these with the llm_provider, llm_model, llm_api_key and llm_base_url options.

# Which API to call: openai (default), gemini, anthropic (Claude), or any other name for an OpenAI-compatible API
# (Ollama, vLLM, Azure, OpenRouter, …), which then needs DOCVISION_LLM_BASE_URL.
DOCVISION_LLM_PROVIDER=openai

# Model name, e.g. the model your provider bills you for. The LLM is turned on once this is set;
# without it, only formats that need no LLM (DOCX, XLSX, PPTX, HTML, text, …) can be converted.
DOCVISION_LLM_MODEL=

# API key for the provider. Never logged.
DOCVISION_LLM_API_KEY=

# Endpoint of the API. Only needed for providers other than openai, gemini and anthropic,
# e.g. http://localhost:11434/v1 for Ollama.
# DOCVISION_LLM_BASE_URL=

# Most LLM calls in flight at once. Halved automatically when the provider rate-limits (429/503),
# so set it to what your account allows.
# DOCVISION_LLM_MAX_CONCURRENCY=64

# Retries for a failed LLM call (network errors, 429, 5xx), with backoff.
# Raise it for flaky or heavily rate-limited providers.
# DOCVISION_LLM_MAX_RETRIES=3

# The model's maximum output tokens. Also sets how many PDF pages go in one call (about this ÷ 1000),
# so match it to your model to avoid cut-off pages.
# DOCVISION_LLM_MAX_OUTPUT_TOKENS=16384

# --- S3 (optional) -----------------------------------------------------------
# Server credentials for plain s3://bucket/key sources and destinations (standard AWS variables).
# Not needed on AWS with an IAM role (EC2/ECS/EKS), or when every request passes
# credentials in the URL (s3://KEY:SECRET@bucket/key).

# AWS access key ID.
# AWS_ACCESS_KEY_ID=

# AWS secret access key.
# AWS_SECRET_ACCESS_KEY=

# Session token, only for temporary credentials (STS, SSO).
# AWS_SESSION_TOKEN=

# Region of your buckets when a location doesn't name one (?region=). Default: us-east-1.
# AWS_REGION=us-east-1

# Endpoint of an S3-compatible store (MinIO, Cloudflare R2, …) instead of AWS.
# DOCVISION_S3_ENDPOINT=
